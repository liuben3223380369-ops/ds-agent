# 运行时产生的东西，不进仓库
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/

# 诊断报告（运行时产生）
diagnostics/

# 工作目录与会话状态
workspace/
.dsrun/
.dsenv
.dserr_*
*.log

# 本地 MCP 配置（含本机绝对路径，用 mcp.json.example 生成）
mcp.json

# 密钥：绝不提交
.env
*.key
*.pem
token.txt

# 系统
.DS_Store
Thumbs.db

# 用户自定义 skill（内置三个会自动生成，其余不进仓库）
skills/*.md
!skills/tdd.md
