{
  "mcpServers": {
    "demo": {
      "command": "python3",
      "args": ["mcp_demo_server.py"]
    },
    "filesystem": {
      "command": "python3",
      "args": ["mcp_fs_server.py"],
      "env": {
        "MCP_FS_ROOTS": "/sdcard/Download:/sdcard/Documents",
        "MCP_FS_READONLY": "1"
      }
    }
  }
}
